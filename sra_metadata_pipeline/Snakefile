"""
SRA -> metadata -> BV-BRC assembly -> subtype -> BV-BRC annotation pipeline.

Per run (one or more SRA accessions):
  1. Pull SRA runinfo + BioSample metadata from NCBI (edirect) and build the
     BV-BRC metadata table (scripts/extract_sra_metadata.py).
  2. Per sample: submit the SRA accession to BV-BRC's IRMA viral assembly
     service, wait, fetch the results, pick the combined contigs.
  3. Per sample: read the HA/NA subtype from the assembly FASTA names
     (A_HA_H5.fasta, A_NA_N1.fasta) -- scripts/assembly_subtype.py.
  4. Update the metadata table with the assembly H/N types, subtype and
     genome names (scripts/finalize_metadata.py).
  5. Per sample: submit the contigs to BV-BRC genome annotation (VIGOR4),
     wait, fetch the results; write a per-sample summary report.

Outputs: results/<run>/metadata/<run>_metadata.xlsx (+ .tsv), and per sample
results/<run>/samples/<SRR>/{assembly,annotation}/ + summary_report.md.
See README.md.
"""

import csv
import os
import re
import sys

configfile: "config.yaml"

SCRIPTS = os.path.join(workflow.basedir, "scripts")


def parse_srr_list(value):
    """Split a comma/space/semicolon separated string of SRA accessions."""
    return [s for s in re.split(r"[,\s;]+", str(value).strip()) if s]


SRR_COLUMN_CANDIDATES = ["srr", "Run", "sra_accession"]


def load_samples_from_tsv(path):
    """Samples TSV with an 'srr', 'Run' or 'sra_accession' column (case-insensitive).
    Optional: scientific_name, reference_virus, taxonomy_id. Extra columns ignored."""
    samples = {}
    with open(path, newline="", encoding="utf-8") as fh:
        reader = csv.DictReader(fh, delimiter="\t")
        lower = {n.lower(): n for n in (reader.fieldnames or [])}
        col = next((lower[c.lower()] for c in SRR_COLUMN_CANDIDATES if c.lower() in lower), None)
        if col is None:
            raise ValueError(f"{path}: needs an 'srr', 'Run' or 'sra_accession' column "
                             f"(found: {reader.fieldnames})")
        for row in reader:
            srr = (row.get(col) or "").strip()
            if srr:
                samples[srr] = {
                    "srr": srr,
                    "scientific_name": (row.get("scientific_name") or "").strip(),
                    "reference_virus": (row.get("reference_virus") or "").strip(),
                    "taxonomy_id": (row.get("taxonomy_id") or "").strip(),
                }
    return samples


# Sample sources, in priority order: --config srr=..., samples_tsv, inline samples:
if config.get("srr"):
    config["samples"] = {
        srr: {
            "srr": srr,
            "scientific_name": config.get("scientific_name", ""),
            "reference_virus": config.get("reference_virus", ""),
            "taxonomy_id": config.get("taxonomy_id", ""),
        }
        for srr in parse_srr_list(config["srr"])
    }
elif config.get("samples_tsv"):
    config["samples"] = load_samples_from_tsv(config["samples_tsv"])

SAMPLES = list(config.get("samples") or {})
if not SAMPLES:
    raise ValueError("No samples: use --config srr=SRR..., samples_tsv, or the samples: block in config.yaml")
for s in SAMPLES:
    if not re.fullmatch(r"[SED]RR\d+", s):
        raise ValueError(f"'{s}' is not an SRA run accession (SRR/ERR/DRR)")
# defaults for the annotation job label
for s in SAMPLES:
    config["samples"][s].setdefault("scientific_name", "")
    if not config["samples"][s]["scientific_name"]:
        config["samples"][s]["scientific_name"] = config.get("default_scientific_name", "Influenza A virus")

# Run name: required for multi-sample runs, defaults to the accession for a single one.
RUN = str(config.get("batch_name", "")).strip()
if not RUN:
    if len(SAMPLES) > 1:
        raise ValueError(
            f"This run has {len(SAMPLES)} samples -- also pass --config batch_name=<name>, e.g.\n"
            "  snakemake --cores 4 --keep-going --config samples_tsv=samples.tsv batch_name=flu_2026_10"
        )
    RUN = SAMPLES[0]
if not re.fullmatch(r"[A-Za-z0-9._-]+", RUN):
    raise ValueError(f"batch_name '{RUN}' may only contain letters, digits, '.', '_' and '-'")

RUN_DIR = f"results/{RUN}"
SAMPLE_DIR = f"{RUN_DIR}/samples/{{sample}}"
LOG_DIR = f"logs/{RUN}/{{sample}}"

BVBRC = config["bvbrc"]
WS_BASE = BVBRC["workspace_base"].rstrip("/")
WS_RUN = f"{WS_BASE}/{RUN}"
POLL = BVBRC.get("poll_interval_sec", 30)
TIMEOUT = BVBRC.get("timeout_sec", 21600)
STRATEGY = BVBRC.get("viral_assembly_strategy", "IRMA")
ANNOTATION_RECIPE = BVBRC.get("annotation_recipe", "viral-lowvan")
GENETIC_CODE = BVBRC.get("genetic_code", 11)
DOMAIN = BVBRC.get("domain", "Bacteria")
PUBLIC_FLAG = "--public" if BVBRC.get("public", False) else ""  # private unless public: true

# Local storage: by default the downloaded BV-BRC outputs (assembly/annotation folders,
# contigs.fasta) are temporary -- Snakemake deletes them as soon as the last step that
# needs them has run. Everything stays in the BV-BRC workspace. Only small bookkeeping
# files (job ids, subtype TSV, summary report, metadata table) are kept locally.
# --config keep_local=true keeps full local copies.
KEEP_LOCAL = str(config.get("keep_local", False)).strip().lower() in ("1", "true", "yes")


def local_copy(path):
    return path if KEEP_LOCAL else temp(path)


META = config.get("metadata", {}) or {}
EDIRECT = str(config.get("edirect_path", META.get("edirect_path", "")) or "")
METADATA_XLSX = f"{RUN_DIR}/metadata/{RUN}_metadata.xlsx"


rule all:
    input:
        METADATA_XLSX,
        f"{RUN_DIR}/metadata/.uploaded",
        expand(SAMPLE_DIR + "/summary_report.md", sample=SAMPLES),
        expand(SAMPLE_DIR + "/.summary_uploaded", sample=SAMPLES),


# ---------------------------------------------------------------------------
# 1. NCBI metadata (whole run at once, rate-limited inside the script)
# ---------------------------------------------------------------------------

rule fetch_metadata:
    output:
        ids=f"{RUN_DIR}/metadata/sra_ids.txt",
        xlsx=f"{RUN_DIR}/metadata/ncbi_metadata.xlsx",
    params:
        ids=" ".join(SAMPLES),
        edirect=f"--edirect {EDIRECT}" if EDIRECT else "",
    log:
        f"logs/{RUN}/fetch_metadata.log",
    shell:
        """
        printf '%s\\n' {params.ids} > {output.ids}
        python3 {SCRIPTS}/extract_sra_metadata.py {output.ids} {output.xlsx} \
            {params.edirect} --allow-empty \
            --location country --subtype-suffix &> {log}
        """


# ---------------------------------------------------------------------------
# 2. BV-BRC IRMA assembly
# ---------------------------------------------------------------------------

rule bvbrc_check_login:
    output:
        touch("results/.bvbrc_login_ok"),
    log:
        "logs/bvbrc_login.log",
    shell:
        """
        p3-whoami > {log} 2>&1
        STATUS=$?
        if [ "$STATUS" -ne 0 ] || grep -qi "logged out" {log}; then
            echo "ERROR: not logged in to BV-BRC. Run 'p3-login <username>' first." >&2
            cat {log} >&2
            exit 1
        fi
        """


rule bvbrc_submit_assembly:
    input:
        login="results/.bvbrc_login_ok",
    output:
        jobid=SAMPLE_DIR + "/assembly/job_id.txt",
        flag=touch(SAMPLE_DIR + "/assembly/.complete"),
    params:
        ws_path=lambda wc: f"{WS_RUN}/{wc.sample}",
        local_dir=lambda wc: f"{RUN_DIR}/samples/{wc.sample}/assembly",
    log:
        LOG_DIR + "/bvbrc_submit_assembly.log",
    shell:
        """
        mkdir -p {params.local_dir}
        # p3-submit-viral-assembly does not create its workspace folder itself
        p3-mkdir "{WS_BASE}" >> {log} 2>&1 || true
        p3-mkdir "{WS_RUN}" >> {log} 2>&1 || true
        p3-mkdir "{params.ws_path}" >> {log} 2>&1 || true

        # If the BV-BRC job fails or times out, record FAILED (plus the job id, if one
        # was issued) instead of stopping: the sample then flows through as "assembly
        # job failed", and the batch's metadata table still gets built and uploaded.
        # To retry it later: rerun the same command with --forcerun <this job_id.txt>
        # (the end-of-run report prints the exact command).
        if ! bash {SCRIPTS}/bvbrc_submit_and_wait.sh \
            "{output.jobid}" "{POLL}" "{TIMEOUT}" "{log}" \
            p3-submit-viral-assembly \
                --srr-id "{wildcards.sample}" \
                --strategy "{STRATEGY}" \
                "{params.ws_path}" assembly; then
            JOB_ID="$(cat "{output.jobid}" 2>/dev/null || true)"
            echo "FAILED${{JOB_ID:+ $JOB_ID}}" > "{output.jobid}"
            echo "WARNING: BV-BRC assembly for {wildcards.sample} failed or timed out" \
                 "(job: ${{JOB_ID:-not submitted}}); recorded as FAILED. See {log}." | tee -a {log} >&2
        fi
        """


rule bvbrc_fetch_assembly:
    input:
        flag=SAMPLE_DIR + "/assembly/.complete",
        jobid=SAMPLE_DIR + "/assembly/job_id.txt",
    output:
        local_copy(directory(SAMPLE_DIR + "/assembly/bvbrc_output")),
    params:
        ws_path=lambda wc: f"{WS_RUN}/{wc.sample}/.assembly",
    log:
        LOG_DIR + "/bvbrc_fetch_assembly.log",
    shell:
        """
        mkdir -p {output}
        if grep -q "^FAILED" "{input.jobid}"; then
            echo "Assembly job failed for {wildcards.sample}; nothing to fetch." > {log}
            exit 0
        fi
        p3-cp -r "ws:{params.ws_path}/" {output} &> {log}
        # Drop the raw reads BV-BRC downloaded from SRA (100s of MB, already in SRA).
        # They sit inside the fetched .assembly/ folder, so search one level down too.
        find {output} -maxdepth 2 -type f -name "{wildcards.sample}_*.fastq" -delete
        find {output} -maxdepth 2 -type d -name "{wildcards.sample}" -prune -exec rm -rf {{}} +
        """


rule pick_contigs:
    input:
        SAMPLE_DIR + "/assembly/bvbrc_output",
    output:
        local_copy(SAMPLE_DIR + "/assembly/contigs.fasta"),
    log:
        LOG_DIR + "/pick_contigs.log",
    shell:
        "python3 {SCRIPTS}/pick_contigs.py {input} {output} &> {log}"


# ---------------------------------------------------------------------------
# 3. Subtype from the assembly, 4. final metadata table
# ---------------------------------------------------------------------------

rule assembly_subtype:
    input:
        assembly_dir=SAMPLE_DIR + "/assembly/bvbrc_output",
        contigs=SAMPLE_DIR + "/assembly/contigs.fasta",
        jobid=SAMPLE_DIR + "/assembly/job_id.txt",
    output:
        SAMPLE_DIR + "/assembly/assembly_subtype.tsv",
    log:
        LOG_DIR + "/assembly_subtype.log",
    shell:
        "python3 {SCRIPTS}/assembly_subtype.py --sample {wildcards.sample} "
        "--assembly-dir {input.assembly_dir} --contigs {input.contigs} "
        "--assembly-jobid {input.jobid} --output {output} &> {log}"


rule finalize_metadata:
    input:
        metadata=f"{RUN_DIR}/metadata/ncbi_metadata.xlsx",
        assembly=expand(SAMPLE_DIR + "/assembly/assembly_subtype.tsv", sample=SAMPLES),
    output:
        xlsx=METADATA_XLSX,
        tsv=f"{RUN_DIR}/metadata/{RUN}_metadata.tsv",
    params:
        samples=" ".join(SAMPLES),
    log:
        f"logs/{RUN}/finalize_metadata.log",
    shell:
        "python3 {SCRIPTS}/finalize_metadata.py --metadata {input.metadata} "
        "--assembly {input.assembly} --samples {params.samples} "
        "--output {output.xlsx} --output-tsv {output.tsv} &> {log}"


rule upload_metadata:
    # Copies the final metadata table to {workspace_base}/{run}/metadata/ on BV-BRC.
    # The TSV must upload; the .xlsx is best-effort (BV-BRC may not accept the type).
    input:
        login="results/.bvbrc_login_ok",
        xlsx=METADATA_XLSX,
        tsv=f"{RUN_DIR}/metadata/{RUN}_metadata.tsv",
    output:
        touch(f"{RUN_DIR}/metadata/.uploaded"),
    params:
        ws_dir=f"{WS_RUN}/metadata",
    log:
        f"logs/{RUN}/upload_metadata.log",
    shell:
        """
        p3-mkdir "{WS_BASE}" >> {log} 2>&1 || true
        p3-mkdir "{WS_RUN}" >> {log} 2>&1 || true
        p3-mkdir "{params.ws_dir}" >> {log} 2>&1 || true
        p3-cp -f {input.tsv} "ws:{params.ws_dir}/{RUN}_metadata.tsv" >> {log} 2>&1
        p3-cp -f -m xlsx=xlsx {input.xlsx} "ws:{params.ws_dir}/{RUN}_metadata.xlsx" >> {log} 2>&1 \
            || p3-cp -f {input.xlsx} "ws:{params.ws_dir}/{RUN}_metadata.xlsx" >> {log} 2>&1 \
            || echo "WARNING: BV-BRC did not accept the .xlsx upload; the .tsv was uploaded" >> {log}
        echo "Uploaded metadata to ws:{params.ws_dir}" >> {log}
        """


# ---------------------------------------------------------------------------
# 5. BV-BRC genome annotation (VIGOR4)
# ---------------------------------------------------------------------------

rule bvbrc_submit_annotation:
    input:
        login="results/.bvbrc_login_ok",
        contigs=SAMPLE_DIR + "/assembly/contigs.fasta",
        subtype=SAMPLE_DIR + "/assembly/assembly_subtype.tsv",
    output:
        jobid=SAMPLE_DIR + "/annotation/job_id.txt",
        flag=touch(SAMPLE_DIR + "/annotation/.complete"),
    params:
        ws_path=lambda wc: f"{WS_RUN}/{wc.sample}",
        upload_path=lambda wc: f"{WS_RUN}/{wc.sample}/uploads",
        local_dir=lambda wc: f"{RUN_DIR}/samples/{wc.sample}/annotation",
        sci_name=lambda wc: config["samples"][wc.sample].get("scientific_name", ""),
        ref_virus=lambda wc: config["samples"][wc.sample].get("reference_virus", ""),
        taxonomy_id=lambda wc: config["samples"][wc.sample].get("taxonomy_id", ""),
    log:
        LOG_DIR + "/bvbrc_submit_annotation.log",
    shell:
        """
        mkdir -p {params.local_dir}
        if [ ! -s "{input.contigs}" ]; then
            echo "No assembled contigs available for {wildcards.sample} -- skipping annotation." | tee {log} >&2
            echo "SKIPPED" > {output.jobid}
            exit 0
        fi

        # upload the contigs ourselves (p3-submit-genome-annotation's own upload is unreliable)
        p3-mkdir "{WS_RUN}" >> {log} 2>&1 || true
        p3-mkdir "{params.ws_path}" >> {log} 2>&1 || true
        p3-mkdir "{params.upload_path}" >> {log} 2>&1 || true
        p3-cp -f "{input.contigs}" "ws:{params.upload_path}/contigs.fasta" >> {log} 2>&1

        EXTRA_ARGS=""
        if [ -n "{params.sci_name}" ]; then
            EXTRA_ARGS="$EXTRA_ARGS --scientific-name \\"{params.sci_name}\\""
        fi
        if [ -n "{params.ref_virus}" ]; then
            EXTRA_ARGS="$EXTRA_ARGS --reference-virus \\"{params.ref_virus}\\""
        fi
        if [ -n "{params.taxonomy_id}" ]; then
            EXTRA_ARGS="$EXTRA_ARGS --taxonomy-id {params.taxonomy_id}"
        fi
        eval bash {SCRIPTS}/bvbrc_submit_and_wait.sh \
            "{output.jobid}" "{POLL}" "{TIMEOUT}" "{log}" \
            p3-submit-genome-annotation \
                --overwrite \
                --contigs-file "ws:{params.upload_path}/contigs.fasta" \
                --recipe "{ANNOTATION_RECIPE}" \
                --genetic-code "{GENETIC_CODE}" \
                --domain "{DOMAIN}" \
                --index-nowait \
                {PUBLIC_FLAG} \
                $EXTRA_ARGS \
                "{params.ws_path}" annotation
        """


rule bvbrc_fetch_annotation:
    input:
        flag=SAMPLE_DIR + "/annotation/.complete",
        jobid=SAMPLE_DIR + "/annotation/job_id.txt",
    output:
        local_copy(directory(SAMPLE_DIR + "/annotation/bvbrc_output")),
    params:
        ws_path=lambda wc: f"{WS_RUN}/{wc.sample}/.annotation",
    log:
        LOG_DIR + "/bvbrc_fetch_annotation.log",
    shell:
        """
        mkdir -p {output}
        if grep -qx "SKIPPED" "{input.jobid}"; then
            echo "Annotation was skipped for {wildcards.sample}; nothing to fetch." > {log}
            exit 0
        fi
        p3-cp -r "ws:{params.ws_path}/" {output} &> {log}
        """


rule make_summary:
    input:
        assembly_dir=SAMPLE_DIR + "/assembly/bvbrc_output",
        contigs=SAMPLE_DIR + "/assembly/contigs.fasta",
        annotation_dir=SAMPLE_DIR + "/annotation/bvbrc_output",
        assembly_jobid=SAMPLE_DIR + "/assembly/job_id.txt",
        annotation_jobid=SAMPLE_DIR + "/annotation/job_id.txt",
    output:
        SAMPLE_DIR + "/summary_report.md",
    params:
        ws_path=lambda wc: f"{WS_RUN}/{wc.sample}",
    log:
        LOG_DIR + "/make_summary.log",
    shell:
        "python3 {SCRIPTS}/make_summary.py --sample {wildcards.sample} "
        "--workspace-path \"{params.ws_path}\" "
        "--assembly-dir {input.assembly_dir} --contigs {input.contigs} "
        "--annotation-dir {input.annotation_dir} "
        "--assembly-jobid {input.assembly_jobid} --annotation-jobid {input.annotation_jobid} "
        "--output {output} &> {log}"


rule upload_summary:
    input:
        login="results/.bvbrc_login_ok",
        summary=SAMPLE_DIR + "/summary_report.md",
    output:
        touch(SAMPLE_DIR + "/.summary_uploaded"),
    params:
        ws_path=lambda wc: f"{WS_RUN}/{wc.sample}",
    log:
        LOG_DIR + "/upload_summary.log",
    shell:
        """
        p3-cp -f {input.summary} "ws:{params.ws_path}/summary_report.md" > {log} 2>&1
        """


# ---------------------------------------------------------------------------
# End-of-run report: assembly jobs recorded as FAILED don't stop the run (see
# bvbrc_submit_assembly), so list them here where they can't be missed.
# ---------------------------------------------------------------------------

def failed_assemblies():
    failed = []
    for s in SAMPLES:
        path = f"{RUN_DIR}/samples/{s}/assembly/job_id.txt"
        try:
            with open(path) as fh:
                if fh.read().startswith("FAILED"):
                    failed.append(path)
        except OSError:
            pass
    return failed


def report_failed_assemblies():
    failed = failed_assemblies()
    if failed:
        print(f"\nWARNING: {len(failed)} BV-BRC assembly job(s) failed or timed out "
              "(marked in the metadata table's subtype_note as 'assembly job failed'):",
              file=sys.stderr)
        for path in failed:
            print(f"  {path}", file=sys.stderr)
        # Deleting job_id.txt is not enough: Snakemake does not rebuild a missing
        # intermediate file when the sample's final outputs already exist.
        print("To retry only these samples, rerun the same snakemake command with:\n"
              f"  --forcerun {' '.join(failed)}", file=sys.stderr)


onsuccess:
    report_failed_assemblies()


onerror:
    report_failed_assemblies()
